{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "knoxified-partners",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": true } },
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "vars": {
    "SUPABASE_URL": "https://elpljgrwrzaugsunoidf.supabase.co",
    "MAIN_SITE_URL": "https://knoxified.org",
    "PUBLIC_URL": "https://partners.knoxified.org",
    "MAIL_FROM_NAME": "Knoxified Partners",
    "MAIL_FROM_EMAIL": "affiliates@knoxified.org",
    "MAIL_REPLY_TO": "affiliates@knoxified.org",
    "ADMIN_COPY_EMAIL": "affiliates@knoxified.org"
  }
}
